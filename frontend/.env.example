# Frontend environment variables (Vite only exposes names starting with VITE_)
# Leave the URLs empty for local dev: Vite proxies /api to localhost:5000.
VITE_API_URL=https://your-backend.onrender.com
VITE_SOCKET_URL=https://your-backend.onrender.com
# Same value as VAPID_PUBLIC_KEY in the backend (optional, enables push notifications)
VITE_VAPID_PUBLIC_KEY=
