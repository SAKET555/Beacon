# Beacon backend (Python) environment variables
# Copy this to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development
# Allowed frontend origin(s) for CORS. Required in production. Comma-separate multiple.
CLIENT_URL=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/royal-beacon

# JWT
# At least 32 random characters. Generate with:
# python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Web push (optional). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Calls: TURN relay (optional, strongly recommended so calls work on strict networks)
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# Either a shared secret (coturn use-auth-secret) ...
# TURN_SECRET=
# ... or static credentials (e.g. from a hosted TURN provider)
# TURN_USERNAME=
# TURN_CREDENTIAL=
